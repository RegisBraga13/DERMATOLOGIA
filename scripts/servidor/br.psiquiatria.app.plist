<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>br.psiquiatria.app</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/.venv/bin/python</string>
    <string>__PROJECT_ROOT__/server.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>UserName</key>
  <string>__APP_USER__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PORT</key>
    <string>8000</string>
    <key>HOST</key>
    <string>127.0.0.1</string>
    <key>APP_MODE</key>
    <string>remote</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__USER_HOME__/Library/Logs/psiquiatria-app.log</string>
  <key>StandardErrorPath</key>
  <string>__USER_HOME__/Library/Logs/psiquiatria-app.err.log</string>
</dict>
</plist>
