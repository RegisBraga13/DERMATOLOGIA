# Copie para .env (que é ignorado pelo git) e preencha.
# O servidor bloqueia o download de .env via HTTP, mas nunca versione este arquivo preenchido.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_MAX_OUTPUT_TOKENS=3000
OPENAI_RAG_VECTOR_STORE_ID=
OPENAI_RAG_MAX_RESULTS=8
OPENAI_RAG_SCORE_THRESHOLD=0.55

# TypeSafe Jev (necessário para a triagem de risco na anamnese e para a
# escolha de escopo do Refinamento; sem a chave, as duas etapas seguem
# funcionando em modo reduzido — sem alerta de risco, e com o catálogo
# completo do protocolo em vez do filtrado)
TYPESAFE_API_KEY=

# Diretrizes de conduta: store SEPARADA da dos livros, lida so pelo terceiro
# modo ("Guidelines"), no Tratamento e no Ajuste de conduta. Vazio, o modo
# aparece na tela e avisa que esta fora -- como as demais etapas de IA sem chave.
# Preencher com o id que scripts/ingest_guidelines.py exibe.
OPENAI_GUIDELINES_VECTOR_STORE_ID=

# Supabase (necessário para persistência segura após autenticação)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Porta local do servidor (padrão 8000)
APP_MODE=local
PORT=8000
